    {
      "id": "ledger",
      "lane": "finance",
      "col": 3,
      "type": "database",
      "label": "Posted ledger",
      "sublabel": "One isolated Vault",
      "width": 132
    },
    {
      "id": "report",
      "lane": "finance",
      "col": 4,
      "type": "backend",
      "label": "Three-month report",
      "sublabel": "Cash vs income / expense",
      "width": 132
    },
    {
      "id": "reader",
      "lane": "finance",
      "col": 5,
      "type": "backend",
      "label": "FC reader 1.2.0",
      "sublabel": "FRAG whole-report pack",
      "width": 132
    }
  ],
  "edges": [
    {
      "id": "csv-mapping",
      "from": "csv",
      "to": "mapping",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "mapping-preview",
      "from": "mapping",
      "to": "preview",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "preview-import",
      "from": "preview",
      "to": "import",
      "role": "main",
      "variant": "security"
    },
    {
      "id": "import-post",
      "from": "import",
      "to": "post",
      "role": "main",
      "variant": "security"
    },
    {
      "id": "post-ledger",
      "from": "post",
      "to": "ledger",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "ledger-report",
      "from": "ledger",
      "to": "report",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "report-gui",
      "from": "report",
      "to": "gui",
      "role": "branch",
      "variant": "default"
    },
    {
      "id": "report-reader",
      "from": "report",
      "to": "reader",
      "role": "main",
      "variant": "default"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Source handling",
      "items": [
        "One-to-many rows close only when exact debits and credits balance.",
        "First-row dates are explicit; every source date stays in memos."
      ]
    },
    {
      "dot": "amber",
      "title": "Financial meaning",
      "items": [
        "Cash movement is not the same as income or expense.",
        "Drafts stay excluded; account roles and reversals remain visible."
      ]
    },
    {
      "dot": "slate",
      "title": "Bounded evidence",
      "items": [
        "Pinned reader, exact month whitelist: whole report or reject.",
        "Three months, separate currencies; external completeness is unknown."
      ]
    }
  ]
}
