{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Finance Core 3.3.0 - Posted-ledger monthly review",
    "locale": "en",
    "animation": "none",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "journal",
        "label": "CSV to posted facts",
        "focus": [
          "csv",
          "mapping",
          "preview",
          "import",
          "post",
          "ledger"
        ],
        "note": "Balanced rows use exact decimals. Import and posting require separate human actions."
      },
      {
        "id": "review",
        "label": "Monthly evidence",
        "focus": [
          "ledger",
          "report",
          "gui",
          "reader"
        ],
        "note": "Cash and accrual remain distinct; currencies stay separate and completeness stays unknown."
      }
    ]
  },
  "lanes": [
    {
      "id": "input",
      "label": "Existing local GUI"
    },
    {
      "id": "operations",
      "label": "FC validation and human actions",
      "variant": "exception"
    },
    {
      "id": "finance",
      "label": "Workspace-owned finance"
    }
  ],
  "mainPath": [
    "csv",
    "mapping",
    "preview",
    "import",
    "post",
    "ledger",
    "report",
    "reader"
  ],
  "nodes": [
    {
      "id": "csv",
      "lane": "input",
      "col": 0,
      "type": "external",
      "label": "Journal CSV",
      "sublabel": "Local, never in Git",
      "width": 132
    },
    {
      "id": "mapping",
      "lane": "input",
      "col": 1,
      "type": "frontend",
      "label": "Explicit mapping",
      "sublabel": "Accounts, currency, dates",
      "width": 132
    },
    {
      "id": "gui",
      "lane": "input",
      "col": 5,
      "type": "frontend",
      "label": "Monthly review",
      "sublabel": "Existing FC Reports UI",
      "width": 132
    },
    {
      "id": "preview",
      "lane": "operations",
      "col": 1,
      "type": "backend",
      "label": "Balanced preview",
      "sublabel": "FC Decimal validation",
      "width": 132
    },
    {
      "id": "import",
      "lane": "operations",
      "col": 2,
      "type": "security",
      "label": "Confirm import",
      "sublabel": "Unposted drafts, atomic batch",
      "width": 132
    },
    {
      "id": "post",
      "lane": "operations",
      "col": 3,
      "type": "security",
      "label": "Confirm posting",
      "sublabel": "Backend rules, no bypass",
      "width": 132
